{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|webmanifest|png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "migration/seanime-react-browser": true
    }
  },
  "rewrites": [
    {
      "source": "/home",
      "destination": "/"
    },
    {
      "source": "/discover",
      "destination": "/"
    },
    {
      "source": "/search",
      "destination": "/"
    },
    {
      "source": "/library",
      "destination": "/"
    },
    {
      "source": "/history",
      "destination": "/"
    },
    {
      "source": "/lists",
      "destination": "/"
    },
    {
      "source": "/schedule",
      "destination": "/"
    },
    {
      "source": "/entry",
      "destination": "/"
    },
    {
      "source": "/account",
      "destination": "/"
    },
    {
      "source": "/settings",
      "destination": "/"
    },
    {
      "source": "/manga",
      "destination": "/"
    },
    {
      "source": "/manga/entry",
      "destination": "/"
    },
    {
      "source": "/auth/callback",
      "destination": "/"
    },
    {
      "source": "/public/auth",
      "destination": "/"
    },
    {
      "source": "/section/:name",
      "destination": "/"
    },
    {
      "source": "/anime/:id",
      "destination": "/"
    },
    {
      "source": "/watch/:id",
      "destination": "/"
    },
    {
      "source": "/watch/:id/:episode",
      "destination": "/"
    },
    {
      "source": "/extensions",
      "destination": "/"
    },
    {
      "source": "/extensions/playground",
      "destination": "/"
    },
    {
      "source": "/onlinestream",
      "destination": "/"
    }
  ],
  "buildCommand": "cd seanime-web && npm ci && npx rsbuild build && cd .. && node scripts/package-browser.mjs",
  "outputDirectory": "seanime-web/out"
}
